# Copie este arquivo para ".env" (mesma pasta) antes de rodar "docker compose up".
# Troque os dois valores por segredos fortes antes de usar em produção.
POSTGRES_PASSWORD=troque-esta-senha
JWT_SECRET=troque-este-segredo-por-uma-string-longa-e-aleatoria
# Chave da OpenRouter — IA lê campos que o OCR não conseguiu extrair (opcional)
OPENROUTER_API_KEY=
