generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CABO
  SUBCABO
}

model User {
  id                 Int       @id @default(autoincrement())
  name               String
  username           String    @unique
  passwordHash       String
  phone              String?
  email              String?
  role               Role
  state              String
  city               String
  neighborhood       String?
  zone               String?
  section            String?
  active             Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  deletedAt          DateTime?

  // Cabo responsável (apenas para SUBCABO)
  parentId Int?
  parent   User?  @relation("Hierarchy", fields: [parentId], references: [id])
  subcabos User[] @relation("Hierarchy")

  // Quem realizou o cadastro
  createdById Int?
  createdBy   User?  @relation("Creator", fields: [createdById], references: [id])
  created     User[] @relation("Creator")

  voters     Voter[]
  activities Activity[]
  candidatesCreated Candidate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Candidate {
  id       Int     @id @default(autoincrement())
  name     String
  party    String
  photoUrl String?
  active   Boolean @default(true)
  deletedAt DateTime?

  createdById Int
  createdBy   User @relation(fields: [createdById], references: [id])

  voters Voter[]
  electionResults ElectionResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("candidates")
}

model Voter {
  id           Int     @id @default(autoincrement())
  name         String?
  phone        String?
  state        String?
  city         String?
  neighborhood String?
  gender       String?
  age          Int?
  birthDate    String?
  zone         String?
  section      String?
  notes        String?

  titleNumber String?

  // Candidato para o qual o eleitor demonstrou intenção de voto
  candidateId Int?
  candidate   Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)

  createdById Int
  createdBy   User @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("voters")
}

model Activity {
  id     Int    @id @default(autoincrement())
  action String
  detail String
  userId Int
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@map("activities")
}

model Setting {
  key   String @id
  value String

  @@map("settings")
}

// Resultado oficial de eleição passada (TSE), por zona/seção eleitoral.
// candidateId liga ao candidato do sistema quando houver correspondência
// (ex.: seed do adversário Kevin); importações do TSE usam candidateName/party.
model ElectionResult {
  id            Int        @id @default(autoincrement())
  year          Int
  office        String // GOVERNADOR, SENADOR, DEPUTADO FEDERAL, DEPUTADO ESTADUAL...
  turn          Int // 1 ou 2
  state         String
  city          String
  zone          String
  section       String
  candidateId   Int?
  candidate     Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  candidateName String
  party         String?
  votes         Int
  source        String     @default("TSE") // TSE | FALLBACK (dados fictícios)

  createdAt DateTime @default(now())

  @@unique([year, office, turn, city, zone, section, candidateName])
  @@index([year, city])
  @@index([year, candidateId])
  @@map("election_results")
}
